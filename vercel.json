{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/demo",
      "dest": "/api/public/guider-ahmed-v2.html"
    },
    {
      "src": "/widget.js",
      "dest": "/api/public/widget.js",
      "continue": true,
      "headers": {
        "content-type": "application/javascript; charset=utf-8",
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "src": "/api/salla/callback",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
